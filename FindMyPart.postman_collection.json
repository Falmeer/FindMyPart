            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brake Pad Set\",\n  \"category_id\": 1,\n  \"condition\": \"New\",\n  \"price\": 120.00,\n  \"quantity\": 5,\n  \"description\": \"High quality brake pads for Toyota Camry\",\n  \"compatibility\": \"Toyota Camry 2018-2022\",\n  \"has_warranty\": true\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update Spare Part",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/spare-parts/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 110.00,\n  \"quantity\": 3\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Spare Part",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/spare-parts/1"
          }
        }
      ]
    },
